{
  "name": "bethlehem",
  "version": "0.1.0",
  "private": true,
  "description": "Terrarium — 동작하는 화면을 품은 화면정의서. Bethlehem(작성 프로그램)과 Manna(내보낸 문서).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "start": "npm run build:manna && electron-vite dev",
    "build:manna": "npm run build:agent && vite build -c packages/manna/vite.config.ts",
    "bake": "npm run build:manna && tsx scripts/bake.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run bake -- example/proto out/e2e/proto.terr.html --entry \"index - old.html,index.html\" && tsx tests/e2e.ts",
    "test:e2e:app": "npm run build:manna && electron-vite build && tsx tests/e2e-bethlehem.ts",
    "build:agent": "vite build -c packages/manna/vite.agent.config.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "pretendard": "^1.3.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@preact/signals": "^2.11.3",
    "lucide-preact": "^1.49.0",
    "preact": "^10.29.8"
  }
}
