{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": false,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@core": ["packages/core/src"],
      "@core/*": ["packages/core/*"],
      "@manna/*": ["packages/manna/src/*"]
    }
  },
  "include": ["packages", "apps", "scripts", "tests", "*.config.ts", "electron.vite.config.ts"]
}
